{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",

      "Read(src/**)",
      "Read(app/**)",
      "Read(components/**)",
      "Read(pages/**)",
      "Read(styles/**)",
      "Read(public/**)",
      "Read(docs/**)",
      "Read(.claude/**)",
      "Read(*.md)",
      "Read(*.json)",
      "Read(*.yaml)",
      "Read(*.yml)",
      "Read(*.ts)",
      "Read(*.tsx)",
      "Read(*.css)",

      "Edit(src/**)",
      "Edit(app/**)",
      "Edit(components/**)",
      "Edit(pages/**)",
      "Edit(styles/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",

      "Write(src/**)",
      "Write(app/**)",
      "Write(components/**)",
      "Write(pages/**)",
      "Write(styles/**)",
      "Write(docs/**)",
      "Write(.claude/**)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(docker:*)",
      "WebFetch",
      "WebSearch"
    ],

    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials/**)",

      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(export:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(set:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
